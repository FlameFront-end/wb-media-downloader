{
	"name": "wb-media-downloader",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26"
	},
	"scripts": {
		"dev": "npm run dev -w web",
		"build": "npm run build -w web",
		"preview": "npm run preview -w web",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"test:e2e": "npm run test:e2e -w web",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:arch": "npm run lint:arch --workspaces --if-present",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.18.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.8",
		"globals": "17.14.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.1",
		"prettier": "3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0"
	}
}
